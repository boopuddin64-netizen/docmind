# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Web Push (notifications while the app is closed) ──
# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto:you@example.com or your https:// site URL
VAPID_SUBJECT="mailto:you@example.com"
# Bearer token required by /api/dispatch-alerts (cron). Use a long random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=""
# Storage for subscriptions/reminders/sent-markers. Required on Vercel (serverless has no shared disk).
# Free Upstash Redis via the Vercel Marketplace injects these (KV_REST_API_URL / KV_REST_API_TOKEN also accepted).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Optional
# PUSH_STORE_PATH=".data/push-store.json"   # local file store when Upstash is not configured
# PUSH_HIDE_TITLES=1                        # send a generic "You have a reminder due" instead of the reminder title
# PUSH_MAX_LATE_MINUTES=360                 # drop alerts more than N minutes overdue (default 360)
# PUSH_LOCAL_SCHEDULER=0                    # disable the in-process 30s scheduler when running server.ts
